{
  "name": "wp-template",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "@wordpress/env": "^11.5.0",
    "autoprefixer": "^10.5.0",
    "kiso.css": "^1.1.4",
    "postcss": "^8.5.13",
    "sharp": "^0.34.5"
  },
  "resolutions": {
    "picomatch@npm:^4.0.3": "4.0.4",
    "postcss": "8.5.13",
    "simple-git": "3.36.0"
  },
  "scripts": {
    "dev": "concurrently \"yarn watch:scss\" \"vite\"",
    "watch:scss": "node bin/watch-scss-globs.js",
    "build:wp": "vite build --mode wp && node bin/clean-dev-files.js",
    "wp-start": "node bin/update-wp-config.js --wp-env && wp-env start",
    "wp-stop": "wp-env stop",
    "wp-init": "node bin/init-wp-options.js",
    "wp-post:create": "node bin/create-post.js",
    "wp-contents:export": "node bin/export-contents.js",
    "wp-contents:export:sanitized": "node bin/export-contents.js --sanitized",
    "wp-contents:import": "node bin/import-contents.js",
    "wp-plugins:sync": "node bin/sync-wp-plugins.js",
    "update:wp-config": "node bin/update-wp-config.js",
    "init:project": "node bin/init-project.js",
    "format": "yarn _lint-fix && yarn _prettier-fix",
    "format:check": "yarn _lint && yarn _prettier",
    "validate:acf": "node bin/validate-acf-json.js",
    "doctor": "node bin/doctor.js",
    "preinstall": "node bin/check-env.js",
    "_lint": "eslint --ext .js --ignore-path .gitignore . && stylelint \"**/*.{scss,css}\"",
    "_prettier": "prettier --check \"**/*.{html,scss,js,php}\" --ignore-path .prettierignore",
    "_lint-fix": "eslint --fix --ext .js --ignore-path .gitignore . && stylelint --fix \"**/*.{scss,css}\"",
    "_prettier-fix": "prettier --write \"**/*.{html,scss,js,php}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.25.0",
    "chokidar": "^3.6.0",
    "concurrently": "^9.1.2",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "glob": "10.5.0",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^16.8.2",
    "stylelint-config-standard-scss": "13.0.0",
    "stylelint-order": "6.0.4",
    "taks-stylelint-order": "^1.1.3",
    "vite": "^7.3.5",
    "vite-plugin-dev-manifest": "^1.5.0",
    "vite-plugin-live-reload": "^3.1.0",
    "vite-plugin-sass-glob-import": "^6.0.3"
  }
}
